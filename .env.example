# Frontend / Next.js
MONGODB_URI=mongodb://localhost:27017/orthoai
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_REPORT_URL=http://localhost:8000/generate-report

# Optional clinic branding
NEXT_PUBLIC_CLINIC_NAME=OrthoAI
NEXT_PUBLIC_CLINIC_DESC=Advanced Dental AI Solutions
NEXT_PUBLIC_CLINIC_LOGO_URL=/Clinic_Logo.png
NEXT_PUBLIC_CLINIC_LOGO_ALT=OrthoAI Logo
NEXT_PUBLIC_CLINIC_FAVICON=/favicon.png
NEXT_PUBLIC_CLINIC_SPLASH_LOGO=/Text - Logo.png

# Backend / Groq report generation
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=moonshotai/kimi-k2-instruct-0905
GROQ_TIMEOUT_S=30
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
